{
  "$defs": {
    "Check": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "state": {
          "enum": [
            "pass",
            "warn",
            "halt"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "id",
        "state",
        "message"
      ],
      "title": "Check",
      "type": "object"
    },
    "ClockReport": {
      "additionalProperties": false,
      "properties": {
        "clockVersion": {
          "title": "Clockversion",
          "type": "integer"
        },
        "offsetS": {
          "title": "Offsets",
          "type": "integer"
        },
        "proofDetail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proofdetail"
        },
        "proven": {
          "title": "Proven",
          "type": "boolean"
        },
        "source": {
          "const": "measured",
          "default": "measured",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "offsetS",
        "proven",
        "clockVersion"
      ],
      "title": "ClockReport",
      "type": "object"
    },
    "ConnectError": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "type": "string"
          },
          "title": "Actions",
          "type": "array"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "default": {},
          "title": "Detail",
          "type": "object"
        },
        "field": {
          "enum": [
            "password",
            "server",
            "terminalPath",
            "login",
            "symbol"
          ],
          "title": "Field",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "recoverable": {
          "default": true,
          "title": "Recoverable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "field",
        "actions"
      ],
      "title": "ConnectError",
      "type": "object"
    },
    "ConnectProgress": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "anyOf": [
            {
              "$ref": "#/$defs/Check"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "stage": {
          "enum": [
            "locating_terminal",
            "attaching",
            "authorizing",
            "resolving_symbol",
            "measuring_clock",
            "loading_history"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "ok"
      ],
      "title": "ConnectProgress",
      "type": "object"
    },
    "ConnectRequest": {
      "additionalProperties": false,
      "properties": {
        "login": {
          "exclusiveMaximum": 10000000000,
          "minimum": 100000,
          "title": "Login",
          "type": "integer"
        },
        "password": {
          "format": "password",
          "minLength": 1,
          "title": "Password",
          "type": "string",
          "writeOnly": true
        },
        "passwordType": {
          "default": "investor",
          "enum": [
            "investor",
            "master"
          ],
          "title": "Passwordtype",
          "type": "string"
        },
        "remember": {
          "default": false,
          "title": "Remember",
          "type": "boolean"
        },
        "server": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_. -]+$",
          "title": "Server",
          "type": "string"
        },
        "terminalPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terminalpath"
        }
      },
      "required": [
        "login",
        "password",
        "server"
      ],
      "title": "ConnectRequest",
      "type": "object"
    },
    "ConnectResult": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConnectError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/$defs/PreflightReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ConnectResult",
      "type": "object"
    },
    "GateSettings": {
      "additionalProperties": false,
      "properties": {
        "downloadUrl": {
          "title": "Downloadurl",
          "type": "string"
        },
        "idleLockMin": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Idlelockmin"
        },
        "lastServer": {
          "title": "Lastserver",
          "type": "string"
        },
        "profiles": {
          "items": {
            "$ref": "#/$defs/Profile"
          },
          "title": "Profiles",
          "type": "array"
        },
        "servers": {
          "items": {
            "type": "string"
          },
          "title": "Servers",
          "type": "array"
        },
        "signupUrl": {
          "title": "Signupurl",
          "type": "string"
        },
        "terminalPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Terminalpath"
        }
      },
      "required": [
        "profiles",
        "servers",
        "lastServer",
        "terminalPath",
        "idleLockMin",
        "signupUrl",
        "downloadUrl"
      ],
      "title": "GateSettings",
      "type": "object"
    },
    "HistoryDepth": {
      "additionalProperties": false,
      "properties": {
        "bars": {
          "title": "Bars",
          "type": "integer"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "required": {
          "title": "Required",
          "type": "integer"
        }
      },
      "required": [
        "bars",
        "required",
        "ok"
      ],
      "title": "HistoryDepth",
      "type": "object"
    },
    "JsonValue": {},
    "OperatorAccount": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "login": {
          "title": "Login",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "readOnly": {
          "title": "Readonly",
          "type": "boolean"
        },
        "server": {
          "title": "Server",
          "type": "string"
        },
        "tradeMode": {
          "enum": [
            "DEMO",
            "REAL",
            "CONTEST"
          ],
          "title": "Trademode",
          "type": "string"
        }
      },
      "required": [
        "login",
        "server",
        "name",
        "tradeMode",
        "currency",
        "readOnly"
      ],
      "title": "OperatorAccount",
      "type": "object"
    },
    "PreflightReport": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "$ref": "#/$defs/OperatorAccount"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/Check"
          },
          "title": "Checks",
          "type": "array"
        },
        "clock": {
          "$ref": "#/$defs/ClockReport"
        },
        "history": {
          "additionalProperties": {
            "$ref": "#/$defs/HistoryDepth"
          },
          "propertyNames": {
            "enum": [
              "M1",
              "M5",
              "M15",
              "M30",
              "H1",
              "H4",
              "D1",
              "W1",
              "MN1"
            ]
          },
          "title": "History",
          "type": "object"
        },
        "symbol": {
          "$ref": "#/$defs/SymbolReport"
        },
        "symbols": {
          "items": {
            "type": "string"
          },
          "title": "Symbols",
          "type": "array"
        }
      },
      "required": [
        "account",
        "symbol",
        "clock",
        "history",
        "checks"
      ],
      "title": "PreflightReport",
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "lastUsedMs": {
          "minimum": 0,
          "title": "Lastusedms",
          "type": "integer"
        },
        "login": {
          "title": "Login",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passwordType": {
          "default": "investor",
          "enum": [
            "investor",
            "master"
          ],
          "title": "Passwordtype",
          "type": "string"
        },
        "server": {
          "title": "Server",
          "type": "string"
        },
        "terminalPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terminalpath"
        },
        "tradeMode": {
          "enum": [
            "DEMO",
            "REAL",
            "CONTEST"
          ],
          "title": "Trademode",
          "type": "string"
        }
      },
      "required": [
        "login",
        "server",
        "name",
        "tradeMode",
        "lastUsedMs"
      ],
      "title": "Profile",
      "type": "object"
    },
    "SessionStatus": {
      "additionalProperties": false,
      "properties": {
        "clockProven": {
          "title": "Clockproven",
          "type": "boolean"
        },
        "state": {
          "default": "connected",
          "enum": [
            "connected",
            "reconnecting",
            "locked"
          ],
          "title": "State",
          "type": "string"
        },
        "tradeMode": {
          "enum": [
            "DEMO",
            "REAL",
            "CONTEST"
          ],
          "title": "Trademode",
          "type": "string"
        },
        "tradingCapable": {
          "title": "Tradingcapable",
          "type": "boolean"
        }
      },
      "required": [
        "tradeMode",
        "clockProven",
        "tradingCapable"
      ],
      "title": "SessionStatus",
      "type": "object"
    },
    "SymbolReport": {
      "additionalProperties": false,
      "properties": {
        "broker": {
          "title": "Broker",
          "type": "string"
        },
        "canonical": {
          "const": "XAUUSD",
          "default": "XAUUSD",
          "title": "Canonical",
          "type": "string"
        },
        "contractSize": {
          "title": "Contractsize",
          "type": "number"
        },
        "digits": {
          "title": "Digits",
          "type": "integer"
        },
        "point": {
          "title": "Point",
          "type": "number"
        },
        "spreadPoints": {
          "title": "Spreadpoints",
          "type": "number"
        }
      },
      "required": [
        "broker",
        "digits",
        "point",
        "contractSize",
        "spreadPoints"
      ],
      "title": "SymbolReport",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "Check": {
      "$ref": "#/$defs/Check"
    },
    "ClockReport": {
      "$ref": "#/$defs/ClockReport"
    },
    "ConnectError": {
      "$ref": "#/$defs/ConnectError"
    },
    "ConnectProgress": {
      "$ref": "#/$defs/ConnectProgress"
    },
    "ConnectRequest": {
      "$ref": "#/$defs/ConnectRequest"
    },
    "ConnectResult": {
      "$ref": "#/$defs/ConnectResult"
    },
    "GateSettings": {
      "$ref": "#/$defs/GateSettings"
    },
    "HistoryDepth": {
      "$ref": "#/$defs/HistoryDepth"
    },
    "JsonValue": {
      "$ref": "#/$defs/JsonValue"
    },
    "OperatorAccount": {
      "$ref": "#/$defs/OperatorAccount"
    },
    "PreflightReport": {
      "$ref": "#/$defs/PreflightReport"
    },
    "Profile": {
      "$ref": "#/$defs/Profile"
    },
    "SessionStatus": {
      "$ref": "#/$defs/SessionStatus"
    },
    "SymbolReport": {
      "$ref": "#/$defs/SymbolReport"
    }
  },
  "title": "OracleAuth",
  "type": "object"
}
